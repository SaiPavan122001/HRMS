# ===== Database (PostgreSQL) =====
DATABASE_URL=jdbc:postgresql://localhost:5432/hrms
DATABASE_USERNAME=hrms
DATABASE_PASSWORD=change-me

# ===== JWT =====
JWT_SECRET=generate-a-random-256-bit-secret-here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===== Email (SendGrid SMTP relay) =====
MAIL_ENABLED=true
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.your-sendgrid-api-key
MAIL_FROM=verified-sender@yourdomain.com
MAIL_FROM_NAME=HRMS

# ===== OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8081/login/oauth2/code/github

# ===== Frontend / CORS =====
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
