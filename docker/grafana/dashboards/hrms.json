{
  "title": "HRMS Overview",
  "uid": "hrms-overview",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {"id":1,"title":"HTTP requests / sec","type":"timeseries","gridPos":{"x":0,"y":0,"w":8,"h":6},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count[1m])) by (uri)"}]},
    {"id":2,"title":"HTTP p95 latency (s)","type":"timeseries","gridPos":{"x":8,"y":0,"w":8,"h":6},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"}]},
    {"id":3,"title":"JVM memory used","type":"timeseries","gridPos":{"x":16,"y":0,"w":8,"h":6},"targets":[{"expr":"sum(jvm_memory_used_bytes) by (area)"}]},
    {"id":4,"title":"Hikari connections","type":"timeseries","gridPos":{"x":0,"y":6,"w":8,"h":6},"targets":[{"expr":"hikaricp_connections"}]},
    {"id":5,"title":"Emails sent / failed (24h)","type":"stat","gridPos":{"x":8,"y":6,"w":8,"h":6},"targets":[{"expr":"sum(increase(hrms_email_sent_total[24h]))"},{"expr":"sum(increase(hrms_email_failed_total[24h]))"}]},
    {"id":6,"title":"Events processed / failed","type":"timeseries","gridPos":{"x":16,"y":6,"w":8,"h":6},"targets":[{"expr":"sum(rate(hrms_events_processed_total[5m]))"},{"expr":"sum(rate(hrms_events_failed_total[5m]))"}]}
  ],
  "schemaVersion": 39
}
